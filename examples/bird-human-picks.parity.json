  {
   "id": "report-link",
   "title": "每种鸟都有报错入口，自动填好鸟名",
   "from": "birdalbum 每个物种页都有 Report a mistake on GitHub，鸟名已填好",
   "checks": [
    {
     "type": "each",
     "glob": "docs/birds/*/index.html",
     "pattern": "issues/new\\?template=wrong-photo\\.yml&amp;title=%5Bphoto%5D%20[A-Z]"
    },
    {
     "type": "contains",
     "path": "docs/assets/site.js",
     "pattern": "issues/new\\?"
    },
    {
     "type": "exists",
     "path": ".github/ISSUE_TEMPLATE/wrong-photo.yml"
    }
   ]
  },
  {
   "id": "headline",
   "title": "标题和开头一句话说清是什么，不用内部叫法",
   "from": "birdalbum: Every bird on Earth, one sticker each.",
   "checks": [
    {
     "type": "contains",
     "path": "docs/index.html",
     "pattern": "<title>人选鸟图 · 每种鸟一张真实照片"
    },
    {
     "type": "contains",
     "path": "docs/index.html",
     "pattern": "<h1>每种鸟一张真实照片"
    },
    {
     "type": "absent",
     "path": "docs/index.html",
     "pattern": "人选精选|约为花叔|1/9|Claude|eye-check|AviList"
    },
    {
     "type": "none",
     "glob": "docs/*/index.html",
     "pattern": "人选精选|约为花叔|1/9|Claude"
    }
   ]
  },
  {
   "id": "meta",
   "title": "每页都有摘要、分享图、图标和规范网址",
   "from": "birdalbum 每页有 description、og:image、favicon、canonical",
   "checks": [
    {
     "type": "each",
     "glob": "docs/**/index.html",
     "pattern": "<meta name=\"description\" content=\"[^\"]{20,}"
    },
    {
     "type": "each",
     "glob": "docs/**/index.html",
     "pattern": "<meta property=\"og:image\" content=\"https://"
    },
    {
     "type": "each",
     "glob": "docs/**/index.html",
     "pattern": "rel=\"icon\""
    },
    {
     "type": "each",
     "glob": "docs/**/index.html",
     "pattern": "rel=\"canonical\""
    },
    {
     "type": "exists",
     "path": "docs/assets/og.png"
    },
    {
     "type": "exists",
     "path": "docs/assets/favicon.png"
    }
   ]
  },
  {
